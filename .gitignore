node_modules/
dist/
*.log

# Claude Code local permission allowlist (machine-specific)
.claude/settings.local.json

# Local output from `npm run plan`
.plan-out.json

# Demo projects generated while trying things out. A leading `_` marks a folder
# at the root as scratch; these are real vibesquad projects, so without this
# they arrive as a folder of someone else's app inside this repository.
# Matched by shape rather than by name, so the next demo needs no edit here.
/_*/

# Screenshots, recordings and drafts made for writing about this, not for
# shipping it.
*-shots/
*.gif
*.zip
velog-*.md
