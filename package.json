{
  "name": "viberaci",
  "version": "0.2.2",
  "description": "Turn your app idea into an AI coding team: who does what, in what order, with copy-paste prompts for Claude Code and Codex.",
  "license": "MIT",
  "author": "Sunhong Min",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aa1192sh1013-ctrl/vibeRACI.git"
  },
  "homepage": "https://github.com/aa1192sh1013-ctrl/vibeRACI#readme",
  "bugs": {
    "url": "https://github.com/aa1192sh1013-ctrl/vibeRACI/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "ai-agents",
    "scaffolding",
    "vibe-coding",
    "cli"
  ],
  "type": "module",
  "bin": {
    "viberaci": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "viberaci": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "render:example": "tsx scripts/render-example.ts",
    "scaffold": "tsx scripts/scaffold-from-plan.ts",
    "scaffold:example": "tsx scripts/scaffold-example.ts",
    "plan": "tsx scripts/plan-example.ts"
  },
  "dependencies": {
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
